{
  "name": "fichame",
  "version": "2.0.0",
  "description": "Sistema de reclutamiento por NFC para restaurantes, tiendas y cualquier negocio",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "setup": "node src/db/seed.js",
    "check": "node src/db/check.js",
    "retention": "node src/db/retention.js",
    "delete-account": "node src/db/delete-account.js",
    "test": "node --test test/unit.test.js && node test/db.js && node test/smoke.js",
    "test:unit": "node --test test/unit.test.js",
    "test:db": "node test/db.js",
    "test:e2e": "node test/smoke.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22"
  }
}
