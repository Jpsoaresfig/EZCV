# Fíchame — variáveis de ambiente
#
# Copiar para `.env` e preencher. O `.env` está no .gitignore e NUNCA deve ser
# versionado. Este ficheiro de exemplo não contém valores secretos (§28).

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------

PORT=3000

# URL pública gravada nas etiquetas NFC (sem barra no fim).
# Em produção: https://o-teu-dominio.com
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Painel → Project Settings → API
#
# SUPABASE_URL              https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY         chave publishable/anon — pode ser pública
# SUPABASE_SERVICE_ROLE_KEY chave secret/service_role — SÓ no backend
#
# A SUPABASE_SERVICE_ROLE_KEY ignora Row Level Security. Nunca a coloques no
# frontend, num ficheiro versionado, em código público ou em logs.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Buckets do Storage (criados pela migration 0003)
SUPABASE_BUCKET_CVS=cvs
SUPABASE_BUCKET_MEDIA=media

# Ligação direta ao Postgres — usada APENAS por `npm run migrate`, porque o
# supabase-js não executa DDL. A aplicação em si nunca usa isto.
# Supabase → Project Settings → Database → Connection string → URI
# Se a ligação direta falhar (projetos recentes são só IPv6), usar a do
# "Session pooler" na porta 5432.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sessões e cookies
# ---------------------------------------------------------------------------

SESSION_TTL_DAYS=30

# 1 = cookie enviado só por HTTPS (obrigatório em produção)
COOKIE_SECURE=0

# 1 = confiar em X-Forwarded-Proto/For (atrás de proxy reverso)
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Tamanho máximo do CV em PDF, em MB
MAX_CV_MB=5

# Tamanho máximo do logo/foto do estabelecimento, em MB
MAX_IMAGE_MB=2

# ---------------------------------------------------------------------------
# Admin da plataforma (usado por `npm run setup`)
# ---------------------------------------------------------------------------

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador Fíchame

# ---------------------------------------------------------------------------
# SMTP — notificação de nova candidatura
# ---------------------------------------------------------------------------
# Sem SMTP_HOST os emails NÃO são enviados (e o conteúdo não vai para o log).
# Sem SMTP não há recuperação de senha nem avisos por email.
# O email nunca leva o CV em anexo: leva um link para o painel (§21).

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fichame.local

# SMTP_INSECURE=1   # aceitar certificado TLS inválido (apenas testes locais)

# ---------------------------------------------------------------------------
# Identificação do operador (art. 10 LSSI, art. 13 RGPD)
# ---------------------------------------------------------------------------
# Aparecem em /privacidad, /terminos e /encargo. Enquanto vazios, as páginas
# mostram [RAZÓN SOCIAL], [NIF]… — nunca dados inventados.
OPERATOR_LEGAL_NAME=
OPERATOR_NIF=
OPERATOR_ADDRESS=
OPERATOR_PRIVACY_EMAIL=
OPERATOR_REGISTRY=
# Só se tiver sido designado um DPD/DPO
OPERATOR_DPO=

# ---------------------------------------------------------------------------
# Retenção e logs (docs/legal/00-legal-review-required.md)
# ---------------------------------------------------------------------------
# Supressão automática via GET /internal/retention (ex.: Vercel Cron), com
# Authorization: Bearer <CRON_SECRET>. Desligada até RETENTION_AUTO=1 —
# ligar SÓ depois de os prazos estarem validados juridicamente.
CRON_SECRET=
RETENTION_AUTO=0
# Dias de conservação dos logs de segurança e dos pedidos de direitos fechados
SECURITY_LOG_DAYS=365
RIGHTS_REQUEST_DAYS=1095
# Segredo para pseudonimizar emails nos logs (por omissão deriva da service key)
LOG_HMAC_SECRET=
