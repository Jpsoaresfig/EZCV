<%- include('../partials/head', { title: 'Nueva contraseña' }) %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-head">
      <a class="brand" href="/">
        <img class="brand-mark" src="/img/logo.svg?v=<%= assetV %>" alt="" width="28" height="28">
        <span>Fíchame</span>
      </a>
    </div>

    <div class="card">
      <h2>Elige una contraseña nueva</h2>
      <% if (error) { %><div class="flash err"><%= error %></div><% } %>
      <form action="/recuperar/nueva" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <!-- O token chega no fragmento do link (#t=…) e o app.js copia-o para
             aqui. Sem JavaScript, pode colar-se o código manualmente. -->
        <div class="field">
          <label for="token">Código del enlace</label>
          <input id="token" type="text" name="token" maxlength="64" autocomplete="off" data-reset-token required>
          <div class="help">Se rellena solo al abrir el enlace del email.</div>
        </div>
        <div class="field">
          <label for="password">Contraseña nueva <span class="dim label-hint">(mínimo <%= minPassword %> caracteres)</span></label>
          <input id="password" type="password" name="password" required minlength="<%= minPassword %>" autocomplete="new-password">
        </div>
        <div class="field">
          <label for="password2">Repetir contraseña</label>
          <input id="password2" type="password" name="password2" required autocomplete="new-password">
        </div>
        <button class="btn block lg" type="submit">Guardar contraseña</button>
      </form>
      <p class="small muted center auth-alt"><a href="/recuperar">Solicitar un enlace nuevo</a></p>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
