<%- include('../partials/head', { title: 'Candidatura enviada' }) %>

<header class="hero">
  <div class="container-narrow hero-body">
    <h1><%= restaurant.commercial_name || restaurant.name %></h1>
    <p class="sub">Gracias por tu interés</p>
  </div>
</header>

<main class="container-narrow public-main">
  <div class="card center pad-lg">
    <div class="success-mark">✓</div>
    <% if (future) { %>
      <h2>¡Datos guardados correctamente!</h2>
      <p class="muted">
        Conservaremos tu candidatura para futuras oportunidades laborales y te
        contactaremos si surge una vacante.
      </p>
    <% } else { %>
      <h2>¡Candidatura enviada correctamente!</h2>
      <p class="muted">
        El establecimiento ha recibido tus datos y tu CV. Si tu perfil encaja,
        te contactarán por teléfono o email.
      </p>
    <% } %>
    <div class="actions-row center-row spaced">
      <a class="btn secondary" href="/r/<%= restaurant.slug %>">Volver a la página</a>
    </div>
  </div>

  <p class="dim tiny center">
    Puedes pedir el acceso, la rectificación o la supresión de tus datos en
    cualquier momento. <a href="/privacidad">Cómo ejercer tus derechos</a>.
  </p>
</main>

<%- include('../partials/foot') %>
