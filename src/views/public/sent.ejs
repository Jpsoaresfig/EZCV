<%- include('../partials/head', { title: tr('Candidatura enviada') }) %>

<header class="hero">
  <div class="container-narrow hero-body">
    <h1><%= restaurant.commercial_name || restaurant.name %></h1>
    <p class="sub"><%= tr('Gracias por tu interés') %></p>
  </div>
</header>

<main class="container-narrow public-main">
  <div class="card center pad-lg">
    <div class="success-mark">✓</div>
    <% if (future) { %>
      <h2><%= tr('¡Datos guardados correctamente!') %></h2>
      <p class="muted">
        <%= tr('Conservaremos tu candidatura para futuras oportunidades laborales y te contactaremos si surge una vacante.') %>
      </p>
    <% } else { %>
      <h2><%= tr('¡Candidatura enviada correctamente!') %></h2>
      <p class="muted">
        <%= tr('El establecimiento ha recibido tus datos y tu CV. Si tu perfil encaja, te contactarán por teléfono o email.') %>
      </p>
    <% } %>
    <div class="actions-row center-row spaced">
      <a class="btn secondary" href="/r/<%= restaurant.slug %>"><%= tr('Volver a la página') %></a>
    </div>
  </div>

  <p class="dim tiny center">
    <%= tr('Puedes pedir el acceso, la rectificación o la supresión de tus datos, o retirar el consentimiento de futuras oportunidades, en cualquier momento.') %>
    <a href="/r/<%= restaurant.slug %>/privacidad#derechos"><%= tr('Ejercer mis derechos') %></a>.
  </p>
</main>

<%- include('../partials/foot') %>
