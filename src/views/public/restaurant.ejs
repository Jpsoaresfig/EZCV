<%- include('../partials/head', { title: restaurant.name }) %>

<header class="hero <%= restaurant.photo_path ? 'has-photo' : '' %>">
  <% if (restaurant.photo_path) { %>
    <!-- Fotografia como fundo através de <img> e não de background-image:
         o CSP é `style-src 'self'` e bloqueia estilos inline. -->
    <img class="hero-photo" src="/r/<%= restaurant.slug %>/imagen/foto?v=<%= String(restaurant.photo_path).split('/').pop() %>" alt="" aria-hidden="true">
  <% } %>

  <div class="container-narrow hero-body">
    <% if (restaurant.logo_path) { %>
      <img class="hero-logo" src="/r/<%= restaurant.slug %>/imagen/logo?v=<%= String(restaurant.logo_path).split('/').pop() %>" alt="Logo de <%= restaurant.name %>">
    <% } %>

    <h1><%= restaurant.commercial_name || restaurant.name %></h1>

    <% if (restaurant.establishment_type && ESTABLISHMENT_TYPES[restaurant.establishment_type]) { %>
      <p class="sub"><%= ESTABLISHMENT_TYPES[restaurant.establishment_type] %></p>
    <% } %>

    <% if (restaurant.description) { %>
      <p class="hero-desc"><%= restaurant.description %></p>
    <% } %>

    <% if (restaurant.address || restaurant.city) { %>
      <p class="sub hero-place">
        <%= restaurant.address %><% if (restaurant.postal_code) { %>, <%= restaurant.postal_code %><% } %><% if (restaurant.address && restaurant.city) { %> · <% } %><%= restaurant.city %>
      </p>
    <% } %>

    <% if (mode === 'form') { %>
      <span class="badge-open"><span class="dot green"></span> Estamos contratando</span>
    <% } else { %>
      <span class="badge-closed"><span class="dot red"></span> No estamos contratando</span>
    <% } %>
  </div>
</header>

<main class="container-narrow public-main">

<% if (typeof query !== 'undefined' && query && query.err) { %>
  <div class="flash err"><%= query.err %></div>
<% } %>

<% if (mode === 'form') { %>

  <% if (jobs.length > 0) { %>
    <div class="card">
      <h2>Vacantes abiertas</h2>
      <p class="help help-lift">Puedes elegir una en el formulario, o dejarlo sin especificar.</p>
      <% jobs.forEach(function(job) { %>
        <div class="job-item">
          <div class="title"><%= job.title %></div>
          <% if (job.description) { %><p class="desc"><%= job.description %></p><% } %>
          <% if (job.contract_type || job.work_schedule) { %>
            <div class="row spaced-sm">
              <% if (job.contract_type && CONTRACT_TYPES[job.contract_type]) { %>
                <span class="badge slate"><%= CONTRACT_TYPES[job.contract_type] %></span>
              <% } %>
              <% if (job.work_schedule && WORK_SCHEDULES[job.work_schedule]) { %>
                <span class="badge slate"><%= WORK_SCHEDULES[job.work_schedule] %></span>
              <% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="card">
    <h2>Envía tu candidatura</h2>
    <p class="help help-lift">Menos de 2 minutos. Solo necesitas tus datos y tu CV en PDF. No hace falta crear ninguna cuenta.</p>

    <% if (errors && errors.general) { %>
      <div class="flash err"><%= errors.general.join(' ') %></div>
    <% } %>

    <form action="/r/<%= restaurant.slug %>/apply" method="post" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="hp" aria-hidden="true">
        <label>Sitio web</label>
        <input type="text" name="sitio_web" tabindex="-1" autocomplete="off">
      </div>

      <div class="section-title">Tus datos</div>

      <div class="field">
        <label for="nombre">Nombre *</label>
        <input id="nombre" type="text" name="nombre" maxlength="100" required value="<%= form.nombre || '' %>" autocomplete="given-name">
        <% if (errors && errors.nombre) { %><div class="field-error"><%= errors.nombre %></div><% } %>
      </div>

      <div class="field">
        <label for="apellidos">Apellidos</label>
        <input id="apellidos" type="text" name="apellidos" maxlength="100" value="<%= form.apellidos || '' %>" autocomplete="family-name">
      </div>

      <div class="field">
        <label for="email">Email *</label>
        <input id="email" type="email" name="email" maxlength="120" required value="<%= form.email || '' %>" autocomplete="email" inputmode="email">
        <% if (errors && errors.email) { %><div class="field-error"><%= errors.email %></div><% } %>
      </div>

      <div class="field">
        <label for="telefono">Número de teléfono *</label>
        <input id="telefono" type="tel" name="telefono" maxlength="30" required value="<%= form.telefono || '' %>" autocomplete="tel" inputmode="tel">
        <% if (errors && errors.telefono) { %><div class="field-error"><%= errors.telefono %></div><% } %>
      </div>

      <div class="section-title">El puesto</div>

      <div class="field">
        <label for="puesto">Puesto al que aspiras</label>
        <select id="puesto" name="puesto">
          <option value="">No especifico / cualquiera</option>
          <% jobs.forEach(function(job) { %>
            <option value="<%= job.id %>" <%= String(form.puesto) === String(job.id) ? 'selected' : '' %>><%= job.title %></option>
          <% }) %>
          <option value="otro" <%= form.puesto === 'otro' ? 'selected' : '' %>>Otro</option>
        </select>
        <% if (errors && errors.puesto) { %><div class="field-error"><%= errors.puesto %></div><% } %>
      </div>

      <div class="field <%= form.puesto === 'otro' ? '' : 'is-hidden' %>" id="otro-puesto-field">
        <label for="otro_puesto">¿Qué puesto?</label>
        <input id="otro_puesto" type="text" name="otro_puesto" maxlength="80" value="<%= form.otro_puesto || '' %>">
      </div>

      <div class="field">
        <label for="disponibilidad">Disponibilidad</label>
        <select id="disponibilidad" name="disponibilidad">
          <% Object.keys(AVAILABILITIES).forEach(function(key) { %>
            <option value="<%= key %>" <%= form.disponibilidad === key ? 'selected' : '' %>><%= AVAILABILITIES[key] %></option>
          <% }) %>
        </select>
      </div>

      <div class="field">
        <label for="experiencia">Experiencia</label>
        <textarea id="experiencia" name="experiencia" maxlength="2000" placeholder="Ej.: 2 años de atención al cliente en…"><%= form.experiencia || '' %></textarea>
      </div>

      <div class="field">
        <label for="observaciones">Observaciones <span class="dim label-hint">(opcional)</span></label>
        <textarea id="observaciones" name="observaciones" maxlength="1000" placeholder="Ej.: puedo incorporarme en dos semanas."><%= form.observaciones || '' %></textarea>
      </div>

      <div class="notice-box">
        <strong>Comparte solo lo necesario para el puesto.</strong>
        <p>No hace falta —ni en el formulario ni en el CV— tu DNI/NIE, fecha de nacimiento, nacionalidad, estado civil, fotografía, ni datos sobre salud, discapacidad, religión, ideas políticas, afiliación sindical, origen étnico u orientación sexual. Si tu CV los incluye, puedes quitarlos antes de enviarlo.</p>
      </div>

      <div class="section-title">Tu currículum</div>

      <div class="field">
        <label for="cv">CV en PDF *</label>
        <div class="file-pick">
          <input class="file-pick-input" id="cv" type="file" name="cv" accept="application/pdf,.pdf" required>
          <label class="file-pick-box" for="cv">
            <span class="file-pick-icon"><%- icon('file') %></span>
            <span class="file-pick-text">
              <strong data-file-action data-empty="Elegir PDF" data-change="Cambiar archivo">Elegir PDF</strong>
              <span>Toca para buscar tu CV en el móvil</span>
            </span>
          </label>
        </div>
        <div class="file-name" data-file-name></div>
        <div class="help">PDF · máximo <%= maxUploadMb %> MB</div>
        <% if (errors && errors.cv) { %><div class="field-error"><%= errors.cv %></div><% } %>
      </div>

      <div class="section-title">Protección de datos</div>

      <%- include('privacy_layer', { purpose: 'gestionar tu candidatura en este proceso de selección', basis: 'La aplicación, a petición tuya, de medidas precontractuales: tú nos envías la candidatura para optar a un empleo (art. 6.1.b RGPD). No necesitas dar ningún consentimiento para candidatarte.', keep: 'Mientras el proceso siga abierto y, como máximo, ' + retention.inactive + ' sin actividad. Cuando el proceso termine, se borran en ' + retention.closed + ', salvo que marques la casilla de abajo.' }) %>

      <label class="check">
        <input type="checkbox" name="consentimiento_futuro" value="1" <%= form.consent_futuro ? 'checked' : '' %>>
        <span><strong>Opcional.</strong> <%= consentFutureText %></span>
      </label>

      <button class="btn block lg spaced" type="submit">Enviar candidatura</button>
    </form>
  </div>

<% } else { %>

  <div class="card">
    <% if (mode === 'paused') { %>
      <h2>Actualmente no estamos contratando.</h2>
      <p class="muted">Puedes volver a consultar más adelante.</p>
    <% } else { %>
      <h2>Actualmente no tenemos vacantes disponibles.</h2>
      <p class="muted">Déjanos tus datos y te contactaremos cuando haya una oportunidad.</p>
    <% } %>

    <div class="section-title">¿Quieres que guardemos tu candidatura para futuras oportunidades?</div>

    <% if (errors && errors.general) { %>
      <div class="flash err"><%= errors.general.join(' ') %></div>
    <% } %>

    <form action="/r/<%= restaurant.slug %>/interes" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="hp" aria-hidden="true">
        <label>Sitio web</label>
        <input type="text" name="sitio_web" tabindex="-1" autocomplete="off">
      </div>

      <div class="field">
        <label for="nombre">Nombre *</label>
        <input id="nombre" type="text" name="nombre" maxlength="100" required value="<%= form.nombre || '' %>" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="email">Email *</label>
        <input id="email" type="email" name="email" maxlength="120" required value="<%= form.email || '' %>" inputmode="email" autocomplete="email">
      </div>
      <div class="field">
        <label for="telefono">Teléfono *</label>
        <input id="telefono" type="tel" name="telefono" maxlength="30" required value="<%= form.telefono || '' %>" inputmode="tel" autocomplete="tel">
      </div>
      <div class="field">
        <label for="experiencia">¿En qué te gustaría trabajar?</label>
        <textarea id="experiencia" name="experiencia" maxlength="500" rows="3" placeholder="Ej.: camarero/a o dependiente/a, 2 años de experiencia, disponible por las tardes."><%= form.experiencia || '' %></textarea>
        <div class="help">Opcional. Una frase basta. No incluyas datos personales que no sean necesarios.</div>
      </div>

      <%- include('privacy_layer', { purpose: 'avisarte si surge una vacante en este establecimiento', basis: 'Tu consentimiento (art. 6.1.a RGPD), que das marcando la casilla. Puedes retirarlo cuando quieras.', keep: 'Durante ' + retention.reserve + ' desde hoy, o hasta que retires el consentimiento.' }) %>

      <label class="check">
        <input type="checkbox" name="consentimiento_futuro" value="1" <%= form.consent_futuro ? 'checked' : '' %>>
        <span><%= consentInterestText %> *</span>
      </label>

      <button class="btn block lg" type="submit">Guardar mi candidatura</button>
    </form>
  </div>

<% } %>
</main>

<%- include('../partials/foot') %>
