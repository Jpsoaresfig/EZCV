<%- include('../partials/head', { title: 'Reportar un problema' }) %>
<%- include('../partials/panel_nav') %>

<main class="container">
  <div class="page-title">
    <h1>Reportar un problema</h1>
    <a class="btn ghost small" href="/panel">← Inicio</a>
  </div>

  <%- include('../partials/flash') %>

  <div class="card narrow-card">
    <p class="muted">
      Fíchame está en fase de prueba. Si algo no funciona, no se entiende o echas
      algo en falta, cuéntanoslo: lo leemos todo.
    </p>

    <form action="/panel/reportar" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="ref" value="<%= ref %>">
      <input type="hidden" name="pagina" value="<%= page %>">

      <div class="field">
        <label for="tipo">¿Qué quieres contarnos?</label>
        <select id="tipo" name="tipo">
          <% Object.keys(kinds).forEach(function (k) { %>
            <option value="<%= k %>" <%= (ref && k === 'error') ? 'selected' : '' %>><%= kinds[k] %></option>
          <% }) %>
        </select>
      </div>

      <div class="field">
        <label for="mensaje">¿Qué ha pasado?</label>
        <textarea id="mensaje" name="mensaje" maxlength="2000" rows="6" required
          placeholder="Ej.: al guardar una vacante me sale un error. Estaba usando el móvil."></textarea>
      </div>

      <div class="notice-box">
        <strong>No incluyas datos de candidatos</strong>
        <p>Ni nombres, ni teléfonos, ni emails, ni contenido de los CV. Para ayudarte basta con describir lo que hacías.</p>
      </div>

      <% if (ref || page) { %>
        <p class="help">
          Se adjunta automáticamente:
          <% if (page) { %>la página <code><%= page %></code><% } %><% if (ref && page) { %> y <% } %><% if (ref) { %>el código de error <strong><%= ref %></strong><% } %>.
        </p>
      <% } %>

      <button class="btn" type="submit">Enviar reporte</button>
    </form>
  </div>

  <% if (mine.length) { %>
    <div class="card narrow-card">
      <h2>Tus reportes</h2>
      <ul class="report-list">
        <% mine.forEach(function (r) { %>
          <li>
            <div class="report-head">
              <strong><%= kinds[r.kind] || r.kind %></strong>
              <span class="badge report-<%= r.status %>"><%= statuses[r.status] || r.status %></span>
            </div>
            <p class="report-msg"><%= r.message %></p>
            <span class="muted small"><%= fmtRelative(r.created_at) %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
