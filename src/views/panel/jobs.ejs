<%- include('../partials/head', { title: tr('Vacantes') }) %>
<%- include('../partials/panel_nav') %>

<main class="container">
  <div class="page-title">
    <h1><%= tr('Vacantes') %></h1>
    <a class="btn ghost small" href="/panel">← <%= tr('Inicio') %></a>
  </div>

  <%- include('../partials/flash') %>

  <%# Recolhido quando já há vagas: a lista é o que interessa ver primeiro. %>
  <details class="card create-job" <%= jobs.length === 0 ? 'open' : '' %>>
    <summary class="create-job-summary"><span class="create-job-plus">+</span> <%= tr('Nueva vacante') %></summary>
    <p class="help"><%= tr('Solo hace falta el nombre del puesto. Lo demás es opcional.') %></p>

    <form action="/panel/vagas/crear" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="titulo"><%= tr('¿Qué puesto buscas?') %></label>
        <%# datalist: sugestões ao escrever, sem obrigar a escolher uma. %>
        <input id="titulo" type="text" name="titulo" maxlength="80" list="puestos-comunes" placeholder="<%= tr('Ej.: Camarero/a') %>" required>
        <datalist id="puestos-comunes">
          <% ['Camarero/a', 'Cocinero/a', 'Ayudante de cocina', 'Friegaplatos', 'Dependiente/a', 'Cajero/a', 'Repartidor/a', 'Limpieza', 'Recepcionista'].forEach(function (t) { %>
            <option value="<%= tr(t) %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div class="field">
        <label for="descripcion"><%= tr('Cuéntalo en pocas palabras') %> <span class="dim"><%= tr('(opcional)') %></span></label>
        <textarea id="descripcion" name="descripcion" maxlength="2000" placeholder="<%= tr('Ej.: Para fines de semana, turno de tarde. Buen ambiente.') %>"></textarea>
      </div>
      <details class="spaced-sm">
        <summary><%= tr('Añadir más detalles (opcional)') %></summary>
        <div class="details-body">
      <div class="field">
        <label for="requisitos"><%= tr('Requisitos') %></label>
        <textarea id="requisitos" name="requisitos" maxlength="2000" placeholder="<%= tr('Ej.: Experiencia previa (valorada), disponibilidad de fines de semana…') %>"></textarea>
      </div>
      <div class="hint-row">
        <div class="field">
          <label for="contrato"><%= tr('Tipo de contrato') %></label>
          <select id="contrato" name="contrato">
            <% Object.keys(CONTRACT_TYPES).forEach(function(key) { %>
              <option value="<%= key %>"><%= CONTRACT_TYPES[key] %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="jornada"><%= tr('Jornada') %></label>
          <select id="jornada" name="jornada">
            <% Object.keys(WORK_SCHEDULES).forEach(function(key) { %>
              <option value="<%= key %>"><%= WORK_SCHEDULES[key] %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="disponibilidad"><%= tr('Disponibilidad') %></label>
          <select id="disponibilidad" name="disponibilidad">
            <% Object.keys(AVAILABILITIES).forEach(function(key) { %>
              <option value="<%= key %>"><%= AVAILABILITIES[key] %></option>
            <% }) %>
          </select>
        </div>
      </div>
        </div>
      </details>
      <button class="btn lg" type="submit"><%= tr('Publicar vacante') %></button>
    </form>
  </details>

  <div class="page-title">
    <h2><%= tr('Tus vacantes') %></h2>
    <span class="count"><%= jobs.length %></span>
  </div>

  <% if (jobs.length === 0) { %>
    <div class="card empty">
      <span class="empty-icon">💼</span>
      <p><%= tr('Todavía no tienes vacantes. Crea la primera arriba: solo hace falta el nombre del puesto.') %></p>
    </div>
  <% } else { %>
    <div class="stack">
      <% jobs.forEach(function(job) { %>
        <div class="card">
          <div class="row-between">
            <h3 class="flat"><%= job.title %></h3>
            <span class="badge <%= job.active ? 'green' : 'slate' %>"><%= job.active ? tr('Publicada') : tr('En pausa') %></span>
          </div>

          <% if (job.description) { %><p class="muted small pre spaced-sm"><%= job.description %></p><% } %>
          <% if (job.requirements) { %>
            <p class="muted small pre"><strong><%= tr('Requisitos:') %></strong> <%= job.requirements %></p>
          <% } %>

          <div class="row spaced-sm">
            <% if (job.contract_type) { %>
              <span class="badge slate"><%= CONTRACT_TYPES[job.contract_type] || job.contract_type %></span>
            <% } %>
            <% if (job.work_schedule) { %>
              <span class="badge slate"><%= WORK_SCHEDULES[job.work_schedule] || job.work_schedule %></span>
            <% } %>
            <% if (job.availability) { %>
              <span class="badge slate"><%= availabilityLabel(job.availability) %></span>
            <% } %>
          </div>

          <p class="dim tiny spaced-sm">
            <%= plural(job.applicants, 'candidatura recibida', 'candidaturas recibidas') %> · <%= tr('creada el {date}', { date: fmtDate(job.created_at) }) %>
          </p>

          <details>
            <summary><%= tr('Cambiar los datos de la vacante') %></summary>
            <div class="details-body">
              <form action="/panel/vagas/<%= job.id %>/editar" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="field">
                  <label><%= tr('Título') %></label>
                  <input type="text" name="titulo" maxlength="80" value="<%= job.title %>" required>
                </div>
                <div class="field">
                  <label><%= tr('Descripción') %></label>
                  <textarea name="descripcion" maxlength="2000"><%= job.description %></textarea>
                </div>
                <details class="spaced-sm">
                  <summary><%= tr('Más detalles') %></summary>
                  <div class="details-body">
                <div class="field">
                  <label><%= tr('Requisitos') %></label>
                  <textarea name="requisitos" maxlength="2000"><%= job.requirements %></textarea>
                </div>
                <div class="hint-row">
                  <div class="field">
                    <label><%= tr('Tipo de contrato') %></label>
                    <select name="contrato">
                      <% Object.keys(CONTRACT_TYPES).forEach(function(key) { %>
                        <option value="<%= key %>" <%= job.contract_type === key ? 'selected' : '' %>><%= CONTRACT_TYPES[key] %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="field">
                    <label><%= tr('Jornada') %></label>
                    <select name="jornada">
                      <% Object.keys(WORK_SCHEDULES).forEach(function(key) { %>
                        <option value="<%= key %>" <%= job.work_schedule === key ? 'selected' : '' %>><%= WORK_SCHEDULES[key] %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="field">
                    <label><%= tr('Disponibilidad') %></label>
                    <select name="disponibilidad">
                      <% Object.keys(AVAILABILITIES).forEach(function(key) { %>
                        <option value="<%= key %>" <%= job.availability === key ? 'selected' : '' %>><%= AVAILABILITIES[key] %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
                  </div>
                </details>
                <button class="btn" type="submit"><%= tr('Guardar cambios') %></button>
              </form>
            </div>
          </details>

          <div class="actions-row tight">
            <form action="/panel/vagas/<%= job.id %>/toggle" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (job.active) { %>
                <button class="btn secondary small" type="submit"><%= tr('Pausar esta vacante') %></button>
              <% } else { %>
                <button class="btn small" type="submit"><%= tr('Volver a publicar') %></button>
              <% } %>
            </form>
            <details>
              <summary class="summary-danger"><%= tr('Eliminar vacante…') %></summary>
              <div class="details-body">
                <p class="help help-lift"><%= tr('Las candidaturas recibidas para esta vacante se conservan.') %></p>
                <form action="/panel/vagas/<%= job.id %>/eliminar" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn danger small" type="submit"><%= tr('Sí, eliminar esta vacante') %></button>
                </form>
              </div>
            </details>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
