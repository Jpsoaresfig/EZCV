<%- include('../partials/head', { title: 'Inicio' }) %>
<%- include('../partials/panel_nav') %>

<main class="container">
  <div class="page-title">
    <h1><%= firstName ? 'Hola, ' + firstName : 'Hola de nuevo' %></h1>
    <form action="/panel/contratacion" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (restaurant.hiring === 'open') { %>
        <input type="hidden" name="accion" value="pausar">
        <button class="btn secondary small" type="submit"><%- icon('pause') %> Pausar candidaturas</button>
      <% } else { %>
        <input type="hidden" name="accion" value="activar">
        <button class="btn small" type="submit">Activar candidaturas</button>
      <% } %>
    </form>
  </div>

  <%- include('../partials/flash') %>

  <% if (total === 0) { %>
    <%
      /* Guia de primeiros passos: só enquanto não chegou nenhuma candidatura.
       * É o primeiro ecrã de quem acabou de se registar — deve dizer o que
       * fazer a seguir em vez de mostrar uma grelha de zeros. */
      var steps = [
        { done: openJobs > 0, title: 'Publica tu primera vacante', text: 'Camarero, dependiente, cocina… Los candidatos eligen a cuál se apuntan.', href: '/panel/vagas', cta: 'Crear vacante' },
        { done: hasLogo, title: 'Añade tu logo', text: 'Tu página se ve más profesional y los candidatos reconocen tu negocio.', href: '/panel/restaurante', cta: 'Subir logo' },
        { done: false, title: 'Mira tu página como un candidato', text: 'Es lo que se abre al acercar el móvil a la etiqueta.', href: nfcUrl, cta: 'Abrir página', external: true },
        { done: false, title: 'Coloca la etiqueta o imprime el QR', text: 'Graba tu enlace en la etiqueta NFC y ponla a la vista, en la puerta o el mostrador.', href: '/panel/qr', cta: 'Código QR' }
      ];
      var doneCount = steps.filter(function (s) { return s.done; }).length;
    %>
    <section class="card onboarding">
      <div class="onboarding-head">
        <div>
          <h2>Primeros pasos</h2>
          <p class="muted small flat">En unos minutos tu negocio estará listo para recibir candidaturas.</p>
        </div>
        <span class="onboarding-count"><%= doneCount %>/<%= steps.length %></span>
      </div>
      <div class="onboarding-bar"><span class="onboarding-fill onboarding-fill-<%= doneCount %>"></span></div>
      <ol class="steps-list">
        <% steps.forEach(function (s, i) { %>
          <li class="step-item <%= s.done ? 'is-done' : '' %>">
            <span class="step-mark"><%- s.done ? icon('check') : (i + 1) %></span>
            <div class="grow">
              <strong><%= s.title %></strong>
              <span><%= s.text %></span>
            </div>
            <% if (!s.done) { %>
              <a class="btn secondary small" href="<%= s.href %>"<% if (s.external) { %> target="_blank" rel="noopener"<% } %>><%= s.cta %></a>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </section>
  <% } %>

  <div class="status-strip <%= restaurant.hiring === 'open' ? 'is-open' : 'is-paused' %>">
    <span class="dot dot-lg <%= restaurant.hiring === 'open' ? 'green' : 'red' %>"></span>
    <div class="grow">
      <% if (restaurant.hiring === 'open') { %>
        <strong>Aceptando candidaturas</strong>
        <div class="muted small">Tu página está abierta a nuevos candidatos.</div>
      <% } else { %>
        <strong>Candidaturas en pausa</strong>
        <div class="muted small">Tu página muestra «No estamos contratando» y solo recoge datos para futuras oportunidades.</div>
      <% } %>
    </div>
  </div>

  <% var unread = (typeof unreadCount !== 'undefined') ? unreadCount : 0; %>
  <% if (counts.nuevo > 0 || counts.contactar > 0 || counts.entrevista > 0 || unread > 0) { %>
    <div class="card attention">
      <div class="attention-head">
        <h2>Necesita atención</h2>
        <% if (unread > 0) { %>
          <form action="/panel/notificaciones/marcar-leidas" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn ghost small" type="submit">Marcar avisos como leídos</button>
          </form>
        <% } %>
      </div>
      <div class="attention-list">
        <% if (unread > 0 && counts.nuevo === 0) { %>
          <a href="/panel/notificaciones"><strong><%= plural(unread, 'aviso', 'avisos') %></strong> sin leer</a>
        <% } %>
        <% if (counts.nuevo > 0) { %>
          <a href="/panel/candidaturas?estado=nuevo"><strong><%= plural(counts.nuevo, 'candidatura nueva', 'candidaturas nuevas') %></strong> por revisar</a>
        <% } %>
        <% if (counts.contactar > 0) { %>
          <a href="/panel/candidaturas?estado=contactar"><strong><%= plural(counts.contactar, 'candidato', 'candidatos') %></strong> para contactar</a>
        <% } %>
        <% if (counts.entrevista > 0) { %>
          <a href="/panel/candidaturas?estado=entrevista"><strong><%= plural(counts.entrevista, 'candidato', 'candidatos') %></strong> en entrevista</a>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (total > 0) { %>
    <div class="stats stats-4">
      <a class="stat accent" href="/panel/candidaturas">
        <div class="num"><%= total %></div>
        <div class="label">Candidaturas</div>
      </a>
      <a class="stat" href="/panel/candidaturas?estado=nuevo">
        <div class="num"><%= counts.nuevo %></div>
        <div class="label">Nuevas</div>
      </a>
      <a class="stat" href="/panel/candidaturas?estado=entrevista">
        <div class="num"><%= counts.entrevista %></div>
        <div class="label">Entrevistas</div>
      </a>
      <a class="stat" href="/panel/candidaturas?estado=contratado">
        <div class="num"><%= counts.contratado %></div>
        <div class="label">Contratados</div>
      </a>
    </div>
    <div class="mini-stats">
      <a href="/panel/candidaturas"><strong><%= weekCount %></strong> esta semana</a>
      <a href="/panel/candidaturas"><strong><%= monthCount %></strong> este mes</a>
      <a href="/panel/vagas"><strong><%= openJobs %></strong> <%= openJobs === 1 ? 'vacante abierta' : 'vacantes abiertas' %></a>
      <a href="/panel/candidaturas?estado=reserva"><strong><%= counts.reserva %></strong> en reserva</a>
    </div>

    <div class="page-title">
      <h2>Candidaturas recientes</h2>
      <a class="btn ghost small" href="/panel/candidaturas">Ver todas →</a>
    </div>

    <div class="app-list">
      <% recent.forEach(function(r) { %>
        <a class="app-row" href="/panel/candidaturas/<%= r.id %>">
          <span class="avatar"><%= initials(r.first_name, r.last_name) %></span>
          <div class="grow">
            <div class="who"><%= r.first_name %> <%= r.last_name %></div>
            <div class="meta"><%= r.job_title || 'Sin puesto especificado' %></div>
          </div>
          <div class="right">
            <span class="badge <%= (STATUSES[r.status] || {}).color || 'slate' %>"><%= statusLabel(r.status) %></span>
            <div class="meta"><%= fmtRelative(r.applied_at) %></div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
