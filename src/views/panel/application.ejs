<%- include('../partials/head', { title: a.first_name + ' ' + a.last_name }) %>
<%- include('../partials/panel_nav') %>

<main class="container">
  <div class="page-title">
    <h1><%= a.first_name %> <%= a.last_name %></h1>
    <a class="btn ghost small" href="/panel/candidaturas">← Candidaturas</a>
  </div>

  <%- include('../partials/flash') %>

  <!-- Cabeçalho: quem é, em que estado está, e como se fala com a pessoa.
       As ações de contacto ficam aqui em cima porque são o que o dono do
       restaurante vem fazer. -->
  <div class="card">
    <div class="row-between">
      <div class="row">
        <span class="avatar"><%= initials(a.first_name, a.last_name) %></span>
        <div>
          <span class="badge badge-lg <%= (STATUSES[a.status] || {}).color || 'slate' %>"><%= statusLabel(a.status) %></span>
          <div class="muted small spaced-sm">Recibida el <%= fmtDate(a.applied_at) %> (<%= fmtRelative(a.applied_at) %>)</div>
        </div>
      </div>
      <form action="/panel/candidaturas/<%= a.id %>/favorito" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn <%= a.favorite ? 'primary' : 'secondary' %> small" type="submit">
          <%= a.favorite ? '★ Favorito' : '☆ Favorito' %>
        </button>
      </form>
    </div>

    <div class="actions-row">
      <a class="btn small" href="tel:<%= String(a.phone).replace(/[^\d+]/g, '') %>"><%- icon('phone') %> Llamar</a>
      <%
        /* wa.me exige o número internacional sem «+». Os candidatos escrevem
         * quase sempre o móvel espanhol sem indicativo (612 345 678): sem o
         * 34 à frente o WhatsApp abria um número inválido. */
        var wa = String(a.phone).replace(/[^\d]/g, '').replace(/^00/, '');
        if (/^[6789]\d{8}$/.test(wa)) wa = '34' + wa;
      %>
      <% if (wa) { %>
        <a class="btn secondary small btn-wa" href="https://wa.me/<%= wa %>" target="_blank" rel="noopener" title="Abre WhatsApp con este número"><%- icon('chat') %> WhatsApp</a>
      <% } %>
      <a class="btn secondary small" href="mailto:<%= a.email %>?subject=<%= encodeURIComponent('Candidatura para ' + (a.job_title || 'tu establecimiento')) %>"><%- icon('mail') %> Email</a>
    </div>
  </div>

  <div class="detail-cols">
    <div class="stack">

      <div class="card o-datos">
        <div class="section-title">Datos personales</div>
        <div class="detail-grid">
          <div class="detail-item">
            <div class="k">Nombre</div>
            <div class="v"><%= a.first_name %> <%= a.last_name %></div>
          </div>
          <div class="detail-item">
            <div class="k">Email</div>
            <div class="v"><a href="mailto:<%= a.email %>"><%= a.email %></a></div>
          </div>
          <div class="detail-item">
            <div class="k">Teléfono</div>
            <div class="v"><%= a.phone %></div>
          </div>
          <% if (a.doc_number) { %>
            <%# Só candidaturas antigas: o documento deixou de ser recolhido (minimização). %>
            <div class="detail-item">
              <div class="k">Documento</div>
              <div class="v"><%= docTypeLabel(a.doc_type) %> · <%= a.doc_number %>
                <div class="dim tiny">Dato antiguo: ya no se recoge. No lo copies fuera de Fíchame salvo que lo necesites para contratar.</div>
              </div>
            </div>
          <% } %>
        </div>

        <div class="section-title">Información profesional</div>
        <div class="detail-grid">
          <div class="detail-item">
            <div class="k">Puesto</div>
            <div class="v">
              <%= a.job_title || 'No especificado' %>
              <% if (a.job_name) { %>
                <span class="dim small">(<%= a.job_active ? 'vacante activa' : 'vacante cerrada' %>)</span>
              <% } %>
            </div>
          </div>
          <div class="detail-item">
            <div class="k">Disponibilidad</div>
            <div class="v"><%= availabilityLabel(a.availability) || '—' %></div>
          </div>
          <div class="detail-item">
            <div class="k">Protección de datos</div>
            <div class="v">
              <% if (consent) { %>
                <div class="small">
                  <% if (consent.selection_basis === 'rgpd_6_1_b') { %>Candidatura: medidas precontractuales (art. 6.1.b RGPD)
                  <% } else if (consent.selection_basis === 'rgpd_6_1_a') { %>Solo interés futuro: consentimiento (art. 6.1.a RGPD)
                  <% } else { %>Candidatura anterior a 2026-10 (registro histórico)<% } %>
                  <% if (consent.privacy_notice_version) { %><span class="dim tiny"> · aviso v<%= consent.privacy_notice_version %></span><% } %>
                </div>
                <div class="small">
                  Futuras oportunidades:
                  <% if (consent.future_opportunity_consent && !consent.future_withdrawn_at) { %>
                    <strong>Sí</strong> <span class="dim tiny">desde <%= fmtDate(consent.future_granted_at || consent.created_at) %></span>
                  <% } else if (consent.future_withdrawn_at) { %>
                    <strong>Retirado</strong> <span class="dim tiny">el <%= fmtDate(consent.future_withdrawn_at) %></span>
                  <% } else { %>No<% } %>
                </div>
              <% } else { %>—<% } %>
            </div>
          </div>
        </div>

        <% if (a.experience) { %>
          <div class="section-title">Experiencia</div>
          <p class="pre"><%= a.experience %></p>
        <% } %>
        <% if (a.observations) { %>
          <div class="section-title">Observaciones del candidato</div>
          <p class="pre"><%= a.observations %></p>
        <% } %>
      </div>

      <div class="card o-notas">
        <h2>Notas internas</h2>
        <p class="help help-lift">
          Solo visibles para tu establecimiento. Pero son datos personales del candidato:
          si ejerce su <strong>derecho de acceso</strong>, tendrás que entregárselas.
        </p>
        <div class="notice-box">
          Escribe solo hechos relevantes para el puesto (experiencia, disponibilidad, próximos pasos).
          <strong>No anotes</strong> salud, embarazo, discapacidad, religión, origen, nacionalidad, edad,
          situación familiar, orientación sexual, ideas políticas ni afiliación sindical: son datos
          especialmente protegidos o pueden constituir discriminación en el acceso al empleo.
        </div>

        <form action="/panel/candidaturas/<%= a.id %>/notas" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="nota">Añadir nota</label>
            <textarea id="nota" name="nota" maxlength="2000" placeholder="Ej.: 2 años en sala. Disponible tardes. Entrevista el viernes a las 11."></textarea>
          </div>
          <label class="check check-plain">
            <input type="checkbox" name="confirmar_sensible" value="1">
            <span class="small">Confirmo que esta nota no contiene datos protegidos o que son imprescindibles y legítimos para el puesto (queda registrado).</span>
          </label>
          <button class="btn small" type="submit">Guardar nota</button>
        </form>

        <div class="spaced">
          <% if (notes.length === 0) { %>
            <p class="dim small flat">Sin notas todavía.</p>
          <% } else { %>
            <% notes.forEach(function(note) { %>
              <div class="note">
                <div class="pre"><%= note.body %></div>
                <div class="when">
                  <span><%= fmtDate(note.created_at) %><% if (note.author) { %> · <%= note.author %><% } %></span>
                  <form action="/panel/candidaturas/<%= a.id %>/notas/<%= note.id %>/eliminar" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn danger small" type="submit">Eliminar</button>
                  </form>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

    </div>

    <div class="stack">

      <div class="card o-cv">
        <h2>Currículum</h2>
        <% if (cv) { %>
          <p class="muted small"><%= cv.original_filename %> · <%= fmtSize(cv.size_bytes) %></p>
          <div class="actions-row tight">
            <a class="btn small" href="/panel/cv/<%= cv.id %>" target="_blank" rel="noopener">Ver CV</a>
            <a class="btn secondary small" href="/panel/cv/<%= cv.id %>?descargar=1">Descargar CV</a>
          </div>
        <% } else { %>
          <p class="dim flat">Sin CV adjunto.</p>
        <% } %>
      </div>

      <div class="card o-estado">
        <h2>Estado</h2>
        <form action="/panel/candidaturas/<%= a.id %>/estado" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <select name="status" aria-label="Estado de la candidatura">
              <% Object.keys(STATUSES).forEach(function(key) { %>
                <option value="<%= key %>" <%= a.status === key ? 'selected' : '' %>><%= STATUSES[key].label %></option>
              <% }) %>
            </select>
          </div>
          <button class="btn small block" type="submit">Guardar estado</button>
        </form>
        <p class="help">«Reserva / Futuras oportunidades» solo está disponible si el candidato dio su consentimiento para ello.</p>
      </div>

      <div class="card o-conservacion">
        <h2>Conservación de datos</h2>
        <% if (a.legal_hold) { %>
          <p class="small"><span class="badge amber">Bloqueo activo</span> <%= a.legal_hold_reason %></p>
          <p class="help">Mientras esté activo, la candidatura no se borrará automáticamente ni se podrá eliminar.</p>
          <form action="/panel/candidaturas/<%= a.id %>/bloqueo" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="accion" value="retirar">
            <button class="btn secondary small" type="submit">Retirar bloqueo</button>
          </form>
        <% } else { %>
          <p class="small">
            <% if (a.retention_until) { %>Se borrará automáticamente a partir del <strong><%= fmtDate(a.retention_until) %></strong><% } else { %>Sin fecha de borrado calculada<% } %>.
          </p>
          <details>
            <summary class="small">Bloquear el borrado (obligación legal o reclamación)…</summary>
            <div class="details-body">
              <form action="/panel/candidaturas/<%= a.id %>/bloqueo" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="accion" value="activar">
                <div class="field">
                  <label for="motivo">Motivo *</label>
                  <input id="motivo" type="text" name="motivo" maxlength="300" placeholder="Ej.: reclamación laboral en curso">
                </div>
                <button class="btn secondary small" type="submit">Activar bloqueo</button>
              </form>
            </div>
          </details>
        <% } %>
        <% if (consent && consent.future_opportunity_consent && !consent.future_withdrawn_at) { %>
          <form action="/panel/candidaturas/<%= a.id %>/retirar-consentimiento" method="post" class="spaced-sm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn secondary small" type="submit">Registrar retirada del consentimiento</button>
          </form>
          <p class="help">Úsalo si el candidato te pide que dejes de guardar sus datos para futuras vacantes.</p>
        <% } %>
      </div>

      <div class="card o-derechos">
        <h2>Derechos del candidato</h2>
        <p class="help help-lift">Para atender una solicitud de acceso o portabilidad, descarga todos sus datos en este establecimiento (el CV se descarga aparte).</p>
        <a class="btn secondary small" href="/panel/candidaturas/<%= a.id %>/exportar">Exportar datos (JSON)</a>
      </div>

      <div class="card o-historial">
        <h2>Historial</h2>
        <% if (history.length === 0) { %>
          <p class="dim small flat">Sin eventos todavía.</p>
        <% } else { %>
          <div class="timeline">
            <% history.forEach(function(h) { %>
              <div class="tl-item">
                <div class="tl-body">
                  <strong><%= historyLabel(h.event) %></strong>
                  <%
                    /* Mudança de estado: o texto é composto a partir das
                       colunas old_status/new_status, para as etiquetas
                       acompanharem o idioma da interface em vez de ficarem
                       congeladas na base de dados. */
                    var detalhe = h.detail || '';
                    if (h.event === 'estado' && h.new_status) {
                      detalhe = (h.old_status ? statusLabel(h.old_status) + ' → ' : '') + statusLabel(h.new_status);
                    }
                  %>
                  <% if (detalhe) { %><div class="muted small"><%= detalhe %></div><% } %>
                </div>
                <div class="dim tiny nowrap">
                  <%= fmtDate(h.created_at) %><% if (h.author) { %> · <%= h.author %><% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="card danger-zone o-perigo">
        <h2>Zona peligrosa</h2>
        <p class="help help-lift">Eliminar la candidatura borra también su CV y sus notas de forma permanente.</p>
        <details>
          <summary class="summary-danger">Eliminar esta candidatura…</summary>
          <div class="details-body">
            <form action="/panel/candidaturas/<%= a.id %>/eliminar" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn danger small" type="submit">Sí, eliminar definitivamente</button>
            </form>
          </div>
        </details>
        <details class="spaced-sm">
          <summary class="summary-danger">Suprimir todos los datos de esta persona (derecho de supresión)…</summary>
          <div class="details-body">
            <p class="help">Borra todas sus candidaturas en tu establecimiento, con CV, notas, historial y consentimientos. No afecta a otros establecimientos.</p>
            <form action="/panel/candidaturas/<%= a.id %>/eliminar-candidato" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="check check-plain">
                <input type="checkbox" name="confirmo" value="1">
                <span class="small">Confirmo la supresión definitiva.</span>
              </label>
              <button class="btn danger small" type="submit">Suprimir datos del candidato</button>
            </form>
          </div>
        </details>
      </div>

    </div>
  </div>
</main>

<%- include('../partials/foot') %>
