<%- include('../partials/head', { title: a.first_name + ' ' + a.last_name }) %>
<%- include('../partials/panel_nav') %>

<main class="container">
  <div class="page-title">
    <h1><%= a.first_name %> <%= a.last_name %></h1>
    <div class="row">
      <a class="btn ghost small" href="/panel/candidaturas">← <%= tr('Candidaturas') %></a>
      <% if (next) { %><a class="btn secondary small" href="/panel/candidaturas/<%= next.id %>"><%= tr('Siguiente') %> →</a><% } %>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <!-- Cabeçalho: quem é, em que estado está, e como se fala com a pessoa.
       As ações de contacto ficam aqui em cima porque são o que o dono do
       restaurante vem fazer. -->
  <div class="card">
    <div class="row-between">
      <div class="row">
        <span class="avatar"><%= initials(a.first_name, a.last_name) %></span>
        <div>
          <span class="badge badge-lg <%= (STATUSES[a.status] || {}).color || 'slate' %>"><%= statusLabel(a.status) %></span>
          <%
            /* fmtRelative só difere da data em «Hoy»/«Ayer»; nos outros dias
             * devolve a própria data, que ficava repetida entre parênteses. */
            var rel = fmtRelative(a.applied_at), day = fmtDate(a.applied_at);
          %>
          <div class="muted small spaced-sm"><%= tr('Recibida el {date}', { date: day }) %><% if (rel && rel !== day) { %> (<%= rel %>)<% } %></div>
        </div>
      </div>
      <form action="/panel/candidaturas/<%= a.id %>/favorito" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn <%= a.favorite ? 'primary' : 'secondary' %> small" type="submit">
          <%= (a.favorite ? '★ ' : '☆ ') + tr('Favorito') %>
        </button>
      </form>
    </div>

    <div class="actions-row">
      <a class="btn" href="tel:<%= String(a.phone).replace(/[^\d+]/g, '') %>"><%- icon('phone') %> <%= tr('Llamar') %></a>
      <%
        /* wa.me exige o número internacional sem «+». Os candidatos escrevem
         * quase sempre o móvel espanhol sem indicativo (612 345 678): sem o
         * 34 à frente o WhatsApp abria um número inválido. */
        var wa = String(a.phone).replace(/[^\d]/g, '').replace(/^00/, '');
        if (/^[6789]\d{8}$/.test(wa)) wa = '34' + wa;
        /* Mensagem já escrita: o dono só tem de carregar em enviar. */
        var waText = tr('Hola {name}, te escribo de {business}. Hemos visto tu candidatura para {job}. ¿Cuándo te viene bien hablar?', {
          name: a.first_name,
          business: restaurantName || tr('nuestro establecimiento'),
          job: a.job_title || tr('trabajar con nosotros')
        });
      %>
      <% if (wa) { %>
        <a class="btn secondary btn-wa" href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent(waText) %>" target="_blank" rel="noopener" title="<%= tr('Abre WhatsApp con este número') %>"><%- icon('chat') %> WhatsApp</a>
      <% } %>
      <a class="btn secondary" href="mailto:<%= a.email %>?subject=<%= encodeURIComponent(tr('Candidatura para {job}', { job: a.job_title || tr('tu establecimiento') })) %>"><%- icon('mail') %> Email</a>
    </div>
  </div>

  <div class="detail-cols">
    <div class="stack">

      <div class="card o-datos">
        <div class="section-title"><%= tr('Datos personales') %></div>
        <div class="detail-grid">
          <div class="detail-item">
            <div class="k"><%= tr('Nombre') %></div>
            <div class="v"><%= a.first_name %> <%= a.last_name %></div>
          </div>
          <div class="detail-item">
            <div class="k">Email</div>
            <div class="v"><a href="mailto:<%= a.email %>"><%= a.email %></a></div>
          </div>
          <div class="detail-item">
            <div class="k"><%= tr('Teléfono') %></div>
            <div class="v"><%= a.phone %></div>
          </div>
          <% if (a.doc_number) { %>
            <%# Só candidaturas antigas: o documento deixou de ser recolhido (minimização). %>
            <div class="detail-item">
              <div class="k"><%= tr('Documento') %></div>
              <div class="v"><%= docTypeLabel(a.doc_type) %> · <%= a.doc_number %>
                <div class="dim tiny"><%= tr('Dato antiguo: ya no se recoge. No lo copies fuera de Fíchame salvo que lo necesites para contratar.') %></div>
              </div>
            </div>
          <% } %>
        </div>

        <div class="section-title"><%= tr('Información profesional') %></div>
        <div class="detail-grid">
          <div class="detail-item">
            <div class="k"><%= tr('Puesto') %></div>
            <div class="v">
              <%= a.job_title || tr('No especificado') %>
              <% if (a.job_name) { %>
                <span class="dim small">(<%= a.job_active ? tr('vacante activa') : tr('vacante cerrada') %>)</span>
              <% } %>
            </div>
          </div>
          <div class="detail-item">
            <div class="k"><%= tr('Disponibilidad') %></div>
            <div class="v"><%= availabilityLabel(a.availability) || '—' %></div>
          </div>
        </div>

        <% if (a.experience) { %>
          <div class="section-title"><%= tr('Experiencia') %></div>
          <p class="pre"><%= a.experience %></p>
        <% } %>
        <% if (a.observations) { %>
          <div class="section-title"><%= tr('Observaciones del candidato') %></div>
          <p class="pre"><%= a.observations %></p>
        <% } %>
      </div>

      <div class="card o-notas">
        <h2><%= tr('Notas internas') %></h2>
        <p class="help help-lift"><%= tr('Solo las ves tú y tu equipo. Apunta lo útil para el puesto: experiencia, horarios, próximos pasos.') %></p>
        <details class="spaced-sm">
          <summary class="small"><%= tr('¿Qué no debo anotar?') %></summary>
          <div class="details-body">
            <div class="notice-box">
              <%= tr('Escribe solo hechos relevantes para el puesto (experiencia, disponibilidad, próximos pasos).') %>
              <strong><%= tr('No anotes') %></strong>
              <%= tr('salud, embarazo, discapacidad, religión, origen, nacionalidad, edad, situación familiar, orientación sexual, ideas políticas ni afiliación sindical: son datos especialmente protegidos o pueden constituir discriminación en el acceso al empleo.') %>
            </div>
            <p class="help">
              <%= tr('Solo visibles para tu establecimiento. Pero son datos personales del candidato: si ejerce su') %>
              <strong><%= tr('derecho de acceso') %></strong><%= tr(', tendrás que entregárselas.') %>
            </p>
          </div>
        </details>

        <form action="/panel/candidaturas/<%= a.id %>/notas" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="nota"><%= tr('Añadir nota') %></label>
            <textarea id="nota" name="nota" maxlength="2000" placeholder="<%= tr('Ej.: 2 años en sala. Disponible tardes. Entrevista el viernes a las 11.') %>"></textarea>
          </div>
          <%# A confirmação só aparece depois de o servidor travar uma nota com termos protegidos. %>
          <% if (query.sensible === '1') { %>
            <label class="check check-plain">
              <input type="checkbox" name="confirmar_sensible" value="1">
              <span class="small"><%= tr('Confirmo que esta nota no contiene datos protegidos o que son imprescindibles y legítimos para el puesto (queda registrado).') %></span>
            </label>
          <% } %>
          <button class="btn" type="submit"><%= tr('Guardar nota') %></button>
        </form>

        <div class="spaced">
          <% if (notes.length === 0) { %>
            <p class="dim small flat"><%= tr('Sin notas todavía.') %></p>
          <% } else { %>
            <% notes.forEach(function(note) { %>
              <div class="note">
                <div class="pre"><%= note.body %></div>
                <div class="when">
                  <span><%= fmtDate(note.created_at) %><% if (note.author) { %> · <%= note.author %><% } %></span>
                  <form action="/panel/candidaturas/<%= a.id %>/notas/<%= note.id %>/eliminar" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn danger small" type="submit"><%= tr('Eliminar') %></button>
                  </form>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

    </div>

    <div class="stack">

      <div class="card o-cv">
        <h2><%= tr('Currículum') %></h2>
        <% if (cv) { %>
          <p class="muted small"><%= cv.original_filename %> · <%= fmtSize(cv.size_bytes) %></p>
          <div class="actions-row tight">
            <a class="btn small" href="/panel/cv/<%= cv.id %>" target="_blank" rel="noopener"><%= tr('Ver CV') %></a>
            <a class="btn secondary small" href="/panel/cv/<%= cv.id %>?descargar=1"><%= tr('Descargar CV') %></a>
          </div>
        <% } else { %>
          <p class="dim flat"><%= tr('Sin CV adjunto.') %></p>
        <% } %>
      </div>

      <div class="card o-estado">
        <h2><%= tr('¿En qué punto está?') %></h2>
        <p class="help help-lift"><%= tr('Toca una opción para cambiar el estado.') %></p>
        <%
          /* Botões de um toque em vez de lista + «Guardar»: menos passos e
           * todas as opções à vista. «Reserva» só aparece com consentimento
           * ativo (o servidor recusa-a de qualquer forma). */
          var canReserve = consent && consent.future_opportunity_consent && !consent.future_withdrawn_at;
        %>
        <form action="/panel/candidaturas/<%= a.id %>/estado" method="post" class="status-picker">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% Object.keys(STATUSES).forEach(function(key) { %>
            <% if (key === 'reserva' && !canReserve && a.status !== 'reserva') return; %>
            <button class="status-opt <%= a.status === key ? 'is-current' : '' %>" type="submit" name="status" value="<%= key %>"<% if (a.status === key) { %> aria-current="true"<% } %>>
              <span class="dot <%= (STATUSES[key] || {}).color || 'slate' %>"></span>
              <span><%= statusLabel(key) %></span>
              <% if (a.status === key) { %><%- icon('check') %><% } %>
            </button>
          <% }) %>
        </form>
      </div>

      <%# Raramente usado: privacidade, histórico e eliminar ficam recolhidos. %>
      <details class="card more-card o-mas">
        <summary><%= tr('Más opciones') %> <span class="dim small"><%= tr('historial, privacidad y eliminar') %></span></summary>

      <div class="sub-block">
        <h2><%= tr('Protección de datos') %></h2>
        <% if (consent) { %>
          <div class="small">
            <% if (consent.selection_basis === 'rgpd_6_1_b') { %><%= tr('Candidatura: medidas precontractuales (art. 6.1.b RGPD)') %>
            <% } else if (consent.selection_basis === 'rgpd_6_1_a') { %><%= tr('Solo interés futuro: consentimiento (art. 6.1.a RGPD)') %>
            <% } else { %><%= tr('Candidatura anterior a 2026-10 (registro histórico)') %><% } %>
            <% if (consent.privacy_notice_version) { %><span class="dim tiny"> · <%= tr('aviso v{version}', { version: consent.privacy_notice_version }) %></span><% } %>
          </div>
          <div class="small">
            <%= tr('Futuras oportunidades:') %>
            <% if (consent.future_opportunity_consent && !consent.future_withdrawn_at) { %>
              <strong><%= tr('Sí') %></strong> <span class="dim tiny"><%= tr('desde {date}', { date: fmtDate(consent.future_granted_at || consent.created_at) }) %></span>
            <% } else if (consent.future_withdrawn_at) { %>
              <strong><%= tr('Retirado') %></strong> <span class="dim tiny"><%= tr('el {date}', { date: fmtDate(consent.future_withdrawn_at) }) %></span>
            <% } else { %><%= tr('No') %><% } %>
          </div>
        <% } else { %><p class="dim small flat">—</p><% } %>
      </div>

      <div class="sub-block o-conservacion">
        <h2><%= tr('Conservación de datos') %></h2>
        <% if (a.legal_hold) { %>
          <p class="small"><span class="badge amber"><%= tr('Bloqueo activo') %></span> <%= a.legal_hold_reason %></p>
          <p class="help"><%= tr('Mientras esté activo, la candidatura no se borrará automáticamente ni se podrá eliminar.') %></p>
          <form action="/panel/candidaturas/<%= a.id %>/bloqueo" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="accion" value="retirar">
            <button class="btn secondary small" type="submit"><%= tr('Retirar bloqueo') %></button>
          </form>
        <% } else { %>
          <p class="small">
            <% if (a.retention_until) { %><%= tr('Se borrará automáticamente a partir del') %> <strong><%= fmtDate(a.retention_until) %></strong><% } else { %><%= tr('Sin fecha de borrado calculada') %><% } %>.
          </p>
          <details>
            <summary class="small"><%= tr('Bloquear el borrado (obligación legal o reclamación)…') %></summary>
            <div class="details-body">
              <form action="/panel/candidaturas/<%= a.id %>/bloqueo" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="accion" value="activar">
                <div class="field">
                  <label for="motivo"><%= tr('Motivo *') %></label>
                  <input id="motivo" type="text" name="motivo" maxlength="300" placeholder="<%= tr('Ej.: reclamación laboral en curso') %>">
                </div>
                <button class="btn secondary small" type="submit"><%= tr('Activar bloqueo') %></button>
              </form>
            </div>
          </details>
        <% } %>
        <% if (consent && consent.future_opportunity_consent && !consent.future_withdrawn_at) { %>
          <form action="/panel/candidaturas/<%= a.id %>/retirar-consentimiento" method="post" class="spaced-sm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn secondary small" type="submit"><%= tr('Registrar retirada del consentimiento') %></button>
          </form>
          <p class="help"><%= tr('Úsalo si el candidato te pide que dejes de guardar sus datos para futuras vacantes.') %></p>
        <% } %>
      </div>

      <div class="sub-block o-derechos">
        <h2><%= tr('Derechos del candidato') %></h2>
        <p class="help help-lift"><%= tr('Para atender una solicitud de acceso o portabilidad, descarga todos sus datos en este establecimiento (el CV se descarga aparte).') %></p>
        <a class="btn secondary small" href="/panel/candidaturas/<%= a.id %>/exportar"><%= tr('Exportar datos (JSON)') %></a>
      </div>

      <div class="sub-block o-historial">
        <h2><%= tr('Historial') %></h2>
        <% if (history.length === 0) { %>
          <p class="dim small flat"><%= tr('Sin eventos todavía.') %></p>
        <% } else { %>
          <div class="timeline">
            <% history.forEach(function(h) { %>
              <div class="tl-item">
                <div class="tl-body">
                  <strong><%= historyLabel(h.event) %></strong>
                  <%
                    /* Mudança de estado: o texto é composto a partir das
                       colunas old_status/new_status, para as etiquetas
                       acompanharem o idioma da interface em vez de ficarem
                       congeladas na base de dados. */
                    var detalhe = h.detail || '';
                    /* Os outros detalhes são textos fixos escritos pelas funções
                       SQL (em espanhol); o do bloqueio leva o motivo escrito
                       pelo negócio, que não se traduz. */
                    var BLOQUEIO = 'Conservación bloqueada: ';
                    if (detalhe.indexOf(BLOQUEIO) === 0) {
                      detalhe = tr('Conservación bloqueada: {reason}', { reason: detalhe.slice(BLOQUEIO.length) });
                    } else {
                      detalhe = tr(detalhe);
                    }
                    if (h.event === 'estado' && h.new_status) {
                      detalhe = (h.old_status ? statusLabel(h.old_status) + ' → ' : '') + statusLabel(h.new_status);
                    }
                  %>
                  <% if (detalhe) { %><div class="muted small"><%= detalhe %></div><% } %>
                </div>
                <div class="dim tiny nowrap">
                  <%= fmtDate(h.created_at) %><% if (h.author) { %> · <%= h.author %><% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="sub-block danger-zone o-perigo">
        <h2><%= tr('Zona peligrosa') %></h2>
        <p class="help help-lift"><%= tr('Eliminar la candidatura borra también su CV y sus notas de forma permanente.') %></p>
        <details>
          <summary class="summary-danger"><%= tr('Eliminar esta candidatura…') %></summary>
          <div class="details-body">
            <form action="/panel/candidaturas/<%= a.id %>/eliminar" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn danger small" type="submit"><%= tr('Sí, eliminar definitivamente') %></button>
            </form>
          </div>
        </details>
        <details class="spaced-sm">
          <summary class="summary-danger"><%= tr('Suprimir todos los datos de esta persona (derecho de supresión)…') %></summary>
          <div class="details-body">
            <p class="help"><%= tr('Borra todas sus candidaturas en tu establecimiento, con CV, notas, historial y consentimientos. No afecta a otros establecimientos.') %></p>
            <form action="/panel/candidaturas/<%= a.id %>/eliminar-candidato" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="check check-plain">
                <input type="checkbox" name="confirmo" value="1">
                <span class="small"><%= tr('Confirmo la supresión definitiva.') %></span>
              </label>
              <button class="btn danger small" type="submit"><%= tr('Suprimir datos del candidato') %></button>
            </form>
          </div>
        </details>
      </div>
      </details>

    </div>
  </div>

  <%# Ao acabar de ver uma candidatura, o passo natural é abrir a seguinte. %>
  <% if (next) { %>
    <div class="next-bar">
      <a class="btn lg block" href="/panel/candidaturas/<%= next.id %>"><%= tr(nextIsNew ? 'Ver la siguiente nueva' : 'Siguiente candidato') %> →</a>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
