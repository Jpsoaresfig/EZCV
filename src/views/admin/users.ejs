<%- include('../partials/head', { title: 'Usuarios' }) %>
<%- include('../partials/admin_nav') %>

<main class="container">
  <div class="page-title">
    <h1>Usuarios</h1>
    <span class="count"><%= users.length %></span>
  </div>

  <%- include('../partials/flash') %>

  <% if (helpRequests.length) { %>
    <div class="card pw-requests">
      <h2>Solicitudes de contraseña <span class="badge amber"><%= helpRequests.length %></span></h2>
      <p class="help help-lift">
        Enviadas desde «¿Has olvidado tu contraseña?». Genera el enlace y envíalo desde tu
        email <strong>solo al email de la cuenta</strong>, nunca a otra dirección que te indiquen.
      </p>
      <ul class="pw-request-list">
        <% helpRequests.forEach(function(r) { var u = r.users || {}; %>
          <li>
            <div class="grow">
              <strong><%= u.full_name || '—' %></strong>
              <span class="small muted"><%= u.restaurants ? '· ' + u.restaurants.name : '' %></span>
              <div class="small"><%= u.email %><%= u.phone ? ' · ' + u.phone : '' %></div>
              <div class="small muted">Pedida el <%= fmtDate(r.created_at) %></div>
              <% if (activeLinks.has(r.user_id)) { %>
                <div class="small"><span class="badge cyan">Enlace generado</span> válido hasta <%= fmtDate(activeLinks.get(r.user_id)) %>; se cierra cuando la persona cambie la contraseña.</div>
              <% } %>
            </div>
            <div class="actions-row flat">
              <form action="/admin/usuarios/<%= r.user_id %>/enlace" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn small" type="submit"><%= activeLinks.has(r.user_id) ? 'Generar otro enlace' : 'Generar enlace' %></button>
              </form>
              <form action="/admin/usuarios/<%= r.user_id %>/contrasena/descartar" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn secondary small" type="submit">Descartar</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="card">
    <p class="help help-lift">
      Esta lista contiene nombres y emails. Cada acceso queda registrado en los
      logs de seguridad.
    </p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Email</th><th>Nombre</th><th>Rol</th>
            <th>Establecimiento</th><th>Creado</th><th>Estado</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr id="u-<%= u.id %>" class="<%= pendingIds.has(u.id) ? 'pw-pending' : '' %>">
              <td class="small"><%= u.email %><% if (pendingIds.has(u.id)) { %> <span class="badge amber">Pide contraseña</span><% } %></td>
              <td><%= u.full_name %></td>
              <td><span class="badge <%= u.role === 'admin' ? 'violet' : 'slate' %>"><%= u.role %></span></td>
              <td class="small"><%= u.restaurant_name || '—' %></td>
              <td class="small nowrap"><%= fmtDate(u.created_at) %></td>
              <td><span class="badge <%= u.blocked ? 'red' : 'green' %>"><%= u.blocked ? 'Bloqueado' : 'Activo' %></span></td>
              <td>
                <% if (u.role !== 'admin') { %>
                  <div class="actions-row flat">
                    <form action="/admin/usuarios/<%= u.id %>/bloquear" method="post">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn <%= u.blocked ? 'secondary' : 'danger' %> small" type="submit"><%= u.blocked ? 'Desbloquear' : 'Bloquear' %></button>
                    </form>
                    <form action="/admin/usuarios/<%= u.id %>/enlace" method="post">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn <%= pendingIds.has(u.id) ? '' : 'secondary' %> small" type="submit"<%= u.blocked ? ' disabled' : '' %>>Enlace de contraseña</button>
                    </form>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/foot') %>
