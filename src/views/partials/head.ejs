<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)">
  <% if (typeof description !== 'undefined' && description) { %>
  <meta name="description" content="<%= description %>">
  <% } %>
  <title><%= typeof title !== 'undefined' && title ? title + ' · Fíchame' : 'Fíchame' %></title>
  <link rel="icon" href="/favicon.ico?v=<%= assetV %>" sizes="48x48">
  <link rel="icon" href="/favicon.svg?v=<%= assetV %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
</head>
